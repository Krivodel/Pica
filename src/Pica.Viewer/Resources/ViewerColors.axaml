<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ViewerBackgroundColor">#FF000000</Color>
    <Color x:Key="ViewerCheckerboardDarkColor">#FFB4BAC2</Color>
    <Color x:Key="ViewerCheckerboardLightColor">#FFD5D9DE</Color>
    <Color x:Key="ViewerDestructiveIconColor">#FFB3261E</Color>
    <Color x:Key="ViewerFloatingMenuColor">#FF181818</Color>
    <Color x:Key="ViewerInformationPanelColor">#C0181818</Color>
    <Color x:Key="ViewerAnimationTimelineTrackColor">#CC646464</Color>
    <Color x:Key="ViewerMenuForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="ViewerSaveDimColor">#40000000</Color>
    <Color x:Key="ViewerSavePanelBorderColor">#40FFFFFF</Color>
    <Color x:Key="ViewerToolButtonColor">#FF101010</Color>
    <Color x:Key="ViewerTransparentColor">#00FFFFFF</Color>
</ResourceDictionary>
