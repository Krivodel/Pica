<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="using:System">
    <system:TimeSpan x:Key="ViewerControlsFadeDuration">0:0:0.16</system:TimeSpan>
    <x:Double x:Key="ViewerHiddenControlsOpacity">0</x:Double>
    <Thickness x:Key="ViewerInformationPanelMargin">16</Thickness>
    <x:Double x:Key="ViewerMenuIconSize">18</x:Double>
    <x:Double x:Key="ViewerNavigationAreaMinimumWidth">24</x:Double>
    <x:Double x:Key="ViewerNavigationIconHostSize">60</x:Double>
    <x:Double x:Key="ViewerNavigationIconSize">44</x:Double>
    <x:Double x:Key="ViewerResizeCornerSize">12</x:Double>
    <x:Double x:Key="ViewerResizeEdgeSize">6</x:Double>
    <x:Double x:Key="ViewerToolButtonSize">44</x:Double>
    <x:Double x:Key="ViewerToolIconSize">22</x:Double>
    <x:Double x:Key="ViewerVisibleControlsOpacity">1</x:Double>
    <x:Double x:Key="ViewerWindowButtonSize">64</x:Double>
    <x:Double x:Key="ViewerWindowIconHostSize">36</x:Double>
    <Thickness x:Key="ViewerSettingsButtonMargin">0,0,128,0</Thickness>
    <Thickness x:Key="ViewerWindowModeButtonMargin">0,0,64,0</Thickness>
</ResourceDictionary>
