<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ViewerBackgroundBrush"
                     Color="{StaticResource ViewerBackgroundColor}" />
    <SolidColorBrush x:Key="ViewerCheckerboardDarkBrush"
                     Color="{StaticResource ViewerCheckerboardDarkColor}" />
    <SolidColorBrush x:Key="ViewerCheckerboardLightBrush"
                     Color="{StaticResource ViewerCheckerboardLightColor}" />
    <SolidColorBrush x:Key="ViewerDestructiveIconBrush"
                     Color="{StaticResource ViewerDestructiveIconColor}" />
    <SolidColorBrush x:Key="ViewerFloatingMenuBrush"
                     Color="{StaticResource ViewerFloatingMenuColor}" />
    <SolidColorBrush x:Key="ViewerInformationPanelBrush"
                     Color="{StaticResource ViewerInformationPanelColor}" />
    <SolidColorBrush x:Key="ViewerMenuForegroundBrush"
                     Color="{StaticResource ViewerMenuForegroundColor}" />
    <SolidColorBrush x:Key="ViewerToolButtonBrush"
                     Color="{StaticResource ViewerToolButtonColor}" />
    <SolidColorBrush x:Key="ViewerTransparentBrush"
                     Color="{StaticResource ViewerTransparentColor}" />
</ResourceDictionary>
